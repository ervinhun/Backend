{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "Jwt": {
    "Issuer": "FridgeFriend",
    "Audience": "FridgeFriend.App",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  }
}
