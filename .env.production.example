# Copy this file to .env.production and fill in real values. .env.production
# is git-ignored. Used by `docker-compose.production.yml` to run Flyway
# against the production database (e.g. NeonDB) instead of a local container.
#
# Flyway's CLI wants the JDBC URL and credentials separate — split the
# provider's single `postgres://user:pass@host/db` connection string into
# the three values below:
DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DB_USER=<CHANGE_ME>
DB_PASSWORD=<CHANGE_ME>
