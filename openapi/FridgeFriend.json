              "null",
              "string"
            ]
          }
        }
      },
      "FridgeMemberResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "isOwner": {
            "type": "boolean"
          },
          "canPut": {
            "type": "boolean"
          },
          "canUse": {
            "type": "boolean"
          },
          "accessExpiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FridgeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "inviteCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "maxMembers": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "maxContainers": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "memberCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isOwner": {
            "type": "boolean"
          },
          "canPut": {
            "type": "boolean"
          },
          "canUse": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JoinFridgeRequest": {
        "required": [
          "inviteCode"
        ],
        "type": "object",
        "properties": {
          "inviteCode": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "type": "string"
          },
          "phoneModel": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ]
          },
          "platform": {
            "maxLength": 20,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "maxLength": 200,
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "displayName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "locale": {
            "maxLength": 10,
            "type": [
              "null",
              "string"
            ]
          },
          "phoneModel": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ]
          },
          "platform": {
            "maxLength": 20,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SaveFridgeRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "UpdateMemberRightsRequest": {
        "type": "object",
        "properties": {
          "canPut": {
            "type": "boolean"
          },
          "canUse": {
            "type": "boolean"
          },
          "accessExpiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "UserDto": {
        "required": [
          "id",
          "email",
          "displayName",
          "locale"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
