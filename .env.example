# Copy this file to .env and fill in real values. .env is git-ignored.

# Used by docker compose for the Postgres container (and to build the API's connection string inside compose)
POSTGRES_DB=fridgefriend
POSTGRES_USER=fridgefriend
POSTGRES_PASSWORD=<CHANGE_ME>

# Used when running the API directly with `dotnet run` (Postgres from compose is exposed on localhost:5432).
# Double underscore maps to nested config keys: ConnectionStrings:DefaultConnection
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fridgefriend;Username=fridgefriend;Password=<CHANGE_ME>

# HMAC-SHA256 key for signing access tokens (config key Jwt:Secret). At least 32 characters.
# Generate one with: openssl rand -base64 48
Jwt__Secret=<CHANGE_ME>
